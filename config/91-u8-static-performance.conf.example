# U8 public static performance variants, 2026-10-28. No API or user data caching.
map $http_accept $u8_perf_accept_webp {
    default 0;
    "~*(^|,)\s*image/webp\s*;\s*q=0(?:\.0+)?\s*(,|$)" 0;
    "~*(^|,)\s*image/webp\s*(?:;\s*q=(?:1(?:\.0{0,3})?|0?\.[0-9]{1,3}))?\s*(,|$)" 1;
}
map "$realpath_root|$uri|$u8_perf_accept_webp" $u8_perf_image_path {
    default "";
    "~^/var/www/u8cny/releases/20261101\-chain\-tail\-v150\|/assets/brand/home\-mobile\-u8cny\.png\|1$" "/assets/performance/home-mobile-u8cny-5cfa141f5c31.webp";
