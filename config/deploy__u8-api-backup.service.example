[Unit]
Description=U8 encrypted local database backup and restore verification
After=u8-api.service

[Service]
Type=oneshot
User=u8-api
Group=u8-api
EnvironmentFile=/etc/u8-api.env
ExecStart=/opt/node-v24.19.0-linux-x64/bin/node /opt/u8-api/current/backend/backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/u8-api
