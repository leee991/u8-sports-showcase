server {
 listen 8080;
 server_tokens off;
 access_log off;
 client_max_body_size 256k;
 location ~ ^/api/integrations/kg/(exchange|begin|prepare|settle|round|abort|balance)$ {
  if ($request_method != POST) { return 405; }
  proxy_pass https://u8-platform.example.com;
  proxy_set_header Host u8-platform.example.com;
  proxy_ssl_server_name on;
  proxy_ssl_name u8-platform.example.com;
  proxy_ssl_verify on;
  proxy_ssl_verify_depth 4;
  proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
  proxy_connect_timeout 3s;
  proxy_read_timeout 10s;
  proxy_next_upstream off;
 }
 location / { return 404; }
}
