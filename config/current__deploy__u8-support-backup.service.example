[Unit]
Description=U8 support encrypted local backup and isolated restore check
After=u8-support.service

[Service]
Type=oneshot
User=u8-support
Group=u8-support
EnvironmentFile=/etc/u8-support.env
ExecStart=/opt/node-v24.19.0-linux-x64/bin/node /opt/u8-support/current/scripts/backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/u8-support
