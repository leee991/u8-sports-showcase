[Unit]
Description=U8 independent customer support
After=network.target

[Service]
Type=simple
User=u8-support
Group=u8-support
WorkingDirectory=/opt/u8-support/current
EnvironmentFile=/etc/u8-support.env
Environment=ALLOWED_ORIGINS=https://u8-platform.example.com,https://u8-platform.example.com,https://u8-platform.example.com
ExecStart=/opt/node-v24.19.0-linux-x64/bin/node server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/u8-support
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=8192
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
