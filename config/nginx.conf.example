server {
 listen 80;
 server_name u8-platform.example.com;
 root /usr/share/nginx/html;
 index index.html;
 server_tokens off;
 access_log off;
 add_header Cache-Control no-store always;
 add_header X-Content-Type-Options nosniff always;
 add_header Referrer-Policy no-referrer always;
 add_header Content-Security-Policy "frame-ancestors 'none'" always;
 gzip on;
 gzip_min_length 1024;
 gzip_types application/json application/javascript text/css image/svg+xml;
 location = / { try_files /index.html =404; }
 location = /entry {
  if ($http_origin != 'https://u8-platform.example.com') { return 403; }
  if ($request_method != POST) { return 405; }
  client_max_body_size 2k;
  include fastcgi_params;
  fastcgi_param SCRIPT_FILENAME /srv/app/u8/entry.php;
  fastcgi_pass entry:9000;
 }
 location = /resume {
  if ($http_origin != 'https://u8-platform.example.com') { return 403; }
  if ($request_method != POST) { return 405; }
  client_max_body_size 2k;
  include fastcgi_params;
  fastcgi_param SCRIPT_FILENAME /srv/app/u8/resume.php;
  fastcgi_pass entry:9000;
 }
 location = /ws/15000 {
  if ($http_origin != 'https://u8-platform.example.com') { return 403; }
  proxy_pass http://engine:15000;
  proxy_http_version 1.1;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection upgrade;
  proxy_read_timeout 90s;
 }
 location ~ /\. { return 404; }
 location ~* \.(php|sql|env|log)$ { return 404; }
 location ~* ^/assets/.+/(native|import)/ { add_header Cache-Control "public, max-age=31536000, immutable"; try_files $uri =404; }
 location / { try_files $uri =404; }
}
